<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>GitlabCICDNotify</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ReleaseVersion Condition="'$(ReleaseVersion)' == ''">0.0.0</ReleaseVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish</PublishDir>
    <DefineConstants>$(DefineConstants);ReleaseVersion=$(ReleaseVersion);PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>
</Project>
