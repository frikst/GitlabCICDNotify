<Window Style="{StaticResource {x:Type Window}}" x:Class="GitlabCICDNotify.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O aplikácii · GitLab CI/CD Notify" Width="620" SizeToContent="Height"
        ResizeMode="NoResize" Icon="Assets/App.ico" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
  <Window.Resources>
    <ResourceDictionary Source="/GitlabCICDNotify;component/Assets/AppIcon.xaml"/>
  </Window.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,28">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="AppImage" Width="72" Height="72" Margin="0,0,20,0" Source="{StaticResource AppIcon}"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="GitLab CI/CD Notify" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" FontSize="16" Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,0,0,24">
      <TextBlock Text="Vaše pipelines pod dohľadom." FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Sledovanie GitLab CI/CD pipelines a oznámenia vo Windows."
                 Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24">
      <StackPanel>
        <TextBlock Text="AUTOR" Style="{StaticResource Caption}"/>
        <TextBlock Text="Ján Janech" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,24"/>
        <TextBlock Text="ORGANIZÁCIA" Style="{StaticResource Caption}"/>
        <TextBlock Text="Katedra softvérových technológií" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock Text="Fakulta riadenia a informatiky" FontSize="16" Margin="0,0,0,4"/>
        <TextBlock Text="Žilinská univerzita v Žiline" FontSize="16"/>
        <TextBlock Margin="0,20,0,0" FontSize="16">
          <Hyperlink NavigateUri="https://www.fri.uniza.sk/pracoviska/KST" RequestNavigate="Department_RequestNavigate"
                     Foreground="{DynamicResource AccentBrush}">Web katedry ↗</Hyperlink>
        </TextBlock>
      </StackPanel>
    </Border>
    <Button Grid.Row="3" Content="Zavrieť" HorizontalAlignment="Right" MinWidth="116"
            Margin="0,24,0,0" IsCancel="True" IsDefault="True" Click="Close_Click"/>
  </Grid>
</Window>
