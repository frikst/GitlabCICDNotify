<Window x:Class="GitlabCICDNotify.App.PipelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Priebeh pipeline · GitLab CI/CD Notify" Width="1160" Height="760" MinWidth="800" MinHeight="480">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Obnoviť" Click="Refresh_Click" ToolTip="Znovu načítať stav, aj po dokončení pipeline"/>
        <Button Content="Otvoriť v GitLabe ↗" Click="Browser_Click" Margin="0"/>
      </StackPanel>
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="PRIEBEH PIPELINE" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
        <TextBlock x:Name="PipelineTitle" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,4" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="PipelineDetail" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#E4E8F0" BorderThickness="1" CornerRadius="10">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Text="STAGES A JOBY" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="6,4,0,12"/>
          <TreeView x:Name="JobsTree" BorderThickness="0" Background="Transparent" SelectedItemChanged="Job_Selected" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <TreeView.Resources>
              <Style TargetType="TreeViewItem"><Setter Property="Padding" Value="4,7"/><Setter Property="IsExpanded" Value="True"/></Style>
            </TreeView.Resources>
          </TreeView>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"/>
      <Border Grid.Column="2" Background="#080C12" CornerRadius="10" BorderBrush="#263041" BorderThickness="1">
        <DockPanel Margin="1">
          <Border DockPanel.Dock="Top" Background="#141C28" Padding="16,11" CornerRadius="9,9,0,0">
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="READ ONLY" Foreground="#77879C" FontFamily="Consolas" FontSize="11"/><TextBlock x:Name="JobTitle" Text="Vyberte job" Foreground="#DAE6F3" FontFamily="Consolas" FontSize="13" TextTrimming="CharacterEllipsis"/></DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="#263041" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel><CheckBox x:Name="FollowOutput" DockPanel.Dock="Right" Content="Sledovať výstup" IsChecked="True" Foreground="#AABBD0" Checked="Follow_Checked"/><TextBlock x:Name="TraceHint" Foreground="#77879C" FontSize="11" Text="Ctrl+C kopírovať · Ctrl+A označiť všetko"/></DockPanel>
          </Border>
          <TextBox x:Name="Terminal" Background="Transparent" Foreground="#D7E3EF" BorderThickness="0" Padding="16" FontFamily="Consolas" FontSize="13" IsReadOnly="True" IsUndoEnabled="False" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" SelectionBrush="#405E86" SelectionOpacity="0.7"/>
        </DockPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="ConnectionState" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"/>
  </Grid>
</Window>
