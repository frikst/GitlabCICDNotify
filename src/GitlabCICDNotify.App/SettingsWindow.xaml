<Window x:Class="GitlabCICDNotify.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:GitlabCICDNotify.Core;assembly=GitlabCICDNotify.Core" Title="Nastavenia · GitLab CI/CD Notify" Width="760" Height="860" MinWidth="580" MinHeight="520">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
    <TextBlock Text="NASTAVENIA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Vaše GitLab účty" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,8"/>
    <TextBlock Text="Pripojte ľubovoľný počet inštancií aj viac používateľov na rovnakom GitLabe." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,22"/>
    <ItemsControl ItemsSource="{Binding AccountSettings}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,4,0,10"><StackPanel>
        <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Odpojiť" Click="Remove_Click" Tag="{Binding Id}" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="{Binding Username, StringFormat=@{0}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Instance}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></DockPanel>
        <TextBlock Text="Sledovanie účtu" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Content="Uložiť" Click="SaveMode_Click" Tag="{Binding}" Margin="10,0,0,0" Padding="14,6"/>
          <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Padding="8,6" AutomationProperties.Name="Sledovať pipelines podľa">
            <ComboBoxItem Content="Používateľa, ktorý spustil pipeline" Tag="{x:Static core:MonitoringMode.TriggeringUser}"/>
            <ComboBoxItem Content="Autora commitu" Tag="{x:Static core:MonitoringMode.CommitAuthor}"/>
          </ComboBox>
        </DockPanel>
        <TextBlock Text="Predvolene sledujeme spúšťajúceho používateľa. Voľba platí iba pre tento účet na tejto inštancii. Pri zmene sa sledovanie začne od aktuálneho času." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
      <TextBlock Text="Pripojiť účet" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <TextBlock Text="1. Adresa inštancie" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="InstanceBox" Text="https://gitlab.com" AutomationProperties.Name="Adresa GitLab inštancie" Margin="0,0,0,16"/>
      <TextBlock Text="2. Vytvorte prístupový token" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock Text="Otvorte GitLab, prihláste sa požadovaným účtom a vytvorte osobný token s oprávnením read_api. Názov a oprávnenie predvyplníme." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Button Content="Vytvoriť token v prehliadači ↗" Click="CreateToken_Click" HorizontalAlignment="Left" Margin="0,0,0,18"/>
      <TextBlock Text="3. Vložte token a pripojte sa" FontWeight="SemiBold" Margin="0,0,0,8"/><PasswordBox x:Name="TokenBox" AutomationProperties.Name="Osobný prístupový token" Margin="0,0,0,16"/>
      <Button x:Name="ConnectButton" Content="Overiť a pripojiť účet" Click="Connect_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
      <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel></Border>
    <TextBlock Text="Tokeny sú šifrované pre váš Windows účet. Rovnaké prihlásenie aktualizuje token existujúceho účtu. Odpojením sa token odstráni iba z tejto aplikácie." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,16,2,0"/>
  </StackPanel></ScrollViewer>
</Window>
