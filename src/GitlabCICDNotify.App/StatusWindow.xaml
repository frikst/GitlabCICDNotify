<Window x:Class="GitlabCICDNotify.App.StatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Stav · GitLab CI/CD Notify" Width="920" Height="740" MinWidth="680" MinHeight="500">
  <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Skontrolovať teraz" Click="Refresh_Click"/><Button Content="Nastavenia" Click="Settings_Click" Style="{StaticResource PrimaryButton}" Margin="0"/></StackPanel>
      <StackPanel><TextBlock Text="GITLAB CI/CD NOTIFY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="Prehľad pipelines" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}"/></StackPanel>
    </DockPanel>
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="●  AKTÍVNE" Foreground="#6251D8" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding ActiveCount}" FontSize="36" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="✓  ÚSPEŠNÉ" Foreground="SeaGreen" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding SuccessCount}" FontSize="36" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="×  ZLYHANÉ" Foreground="IndianRed" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding FailedCount}" FontSize="36" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
    </UniformGrid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="PRIPOJENÉ ÚČTY" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Accounts}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Username, StringFormat=@{0}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Instance}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding State}" Foreground="{Binding Color}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="Zatiaľ nemáte pripojený účet. Otvorte Nastavenia a prihláste sa do GitLabu." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,12"/>
        <TextBlock Text="POSLEDNÉ PIPELINES" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="0,18,0,10"/>
        <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}"><StackPanel Margin="0,12"><TextBlock Text="Pripravené na ďalší commit" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Nové pipelines sa tu zobrazia automaticky. Sledovanie beží aj pri zatvorenom okne." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
        <ItemsControl ItemsSource="{Binding Pipelines}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{Binding Color}" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Instance}" Style="{StaticResource Caption}" FontSize="11"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><Button Content="{Binding Status}" Foreground="{Binding Color}" Click="Pipeline_Click" Tag="{Binding}" Padding="12,5" Margin="0" ToolTip="Otvoriť pipeline v prehliadači"/><TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <Expander Grid.Row="3" Header="Diagnostické logy" IsExpanded="False" Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}"><ListBox ItemsSource="{Binding Logs}" MaxHeight="150" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Expander>
  </Grid>
</Window>
